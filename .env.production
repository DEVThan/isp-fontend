# ค่าของ production — ใช้ตอน `next build` / `next start` และใน Docker (commit ไว้ ไม่มีความลับ)
# dev (`npm run dev`) ไม่อ่านไฟล์นี้ — ใช้ .env.local ของเครื่องตัวเองตามเดิม (ดู .env.example)
#
# output: "standalone" ก๊อปไฟล์นี้ไปกับ build และ server.js อ่านตอนรันด้วย (ฝั่ง server ของ api.ts)
# ส่วน rewrites ใน next.config.ts ถูกฝังตั้งแต่ตอน build — แก้ค่าแล้วต้อง build ใหม่
#
# ⚠️ ถ้าเครื่องไหนมี .env.local อยู่ แล้วสั่ง `npm run build` ที่เครื่องนั้น .env.local จะทับค่าในไฟล์นี้
#    (ลำดับของ Next: process.env > .env.production.local > .env.local > .env.production > .env)
#    Docker ไม่โดน — .dockerignore กัน .env.local ไว้

# Flask API (ต่อท้าย /api/web) — browser ยิง /api/web/* แล้ว Next ส่งต่อมาที่นี่
API_BASE_URL=https://api-isp.softtechnw.com/api/web

# ปุ่ม "อัปเดตข้อมูล" ของหน้า so (/so-sync, /so-sync-status)
SO_SYNC_API_BASE_URL=https://api-isp.softtechnw.com/api/web
