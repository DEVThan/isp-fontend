# คัดลอกเป็น .env (ข้าง docker-compose.yml) บนเซิร์ฟเวอร์ — ไม่มีไฟล์นี้ก็ใช้ค่าเริ่มต้นได้เลย

# พอร์ตบนเครื่อง และ interface ที่ฟัง (127.0.0.1 = ให้ nginx proxy มาเท่านั้น)
WEB_PORT=3001
WEB_BIND=127.0.0.1

# (ไม่บังคับ) ทับปลายทาง API ใน .env.production เฉพาะเครื่องนี้ — แก้แล้วต้อง `docker compose up -d --build`
# เช่น API อยู่เครื่องเดียวกันที่ :8081 ไม่อยากวิ่งออกเน็ต → ใช้ IP ของ docker bridge (Linux: http://172.17.0.1:8081/api/web)
# API_BASE_URL=https://api-isp.softtechnw.com/api/web
# SO_SYNC_API_BASE_URL=https://api-isp.softtechnw.com/api/web
